[gd_resource type="Environment" format=3]

; Shared combat look. Floor/walls stay darker and less saturated than the cyan
; (player) and amber (enemy) effect colours; effects read via emission + glow.

[resource]
background_mode = 1
background_color = Color(0.05, 0.06, 0.08, 1)
ambient_light_source = 2
ambient_light_color = Color(0.42, 0.48, 0.58, 1)
ambient_light_energy = 0.4
tonemap_mode = 3
tonemap_exposure = 1.0
tonemap_white = 6.0
glow_enabled = true
glow_intensity = 0.5
glow_strength = 0.9
glow_bloom = 0.0
glow_hdr_threshold = 1.0
glow_hdr_scale = 1.5

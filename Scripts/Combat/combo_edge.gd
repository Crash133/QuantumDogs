@tool
class_name ComboEdge
extends Resource

## Combo inputs the runner accepts. Typing another value still works.
const INPUTS: PackedStringArray = ["light", "heavy"]
enum TransitionMode { IMMEDIATE, AT_TICK }

## Stable editor identity; empty IDs are generated by migration/editor tools.
@export var id: StringName = &""
@export var input: StringName = &"light"
## Node id in the owning graph (suggested once the graph loads).
@export var target: StringName
## Inclusive accepted-input ticks. (-1,-1) reads the legacy node window.
@export_custom(PROPERTY_HINT_RANGE, "-1,3600,1,suffix:ticks @60Hz") var input_window: Vector2i = Vector2i(-1, -1)
@export var transition_mode: TransitionMode = TransitionMode.IMMEDIATE
## Dispatch tick when transition_mode is AT_TICK. Must be within target node duration.
@export_custom(PROPERTY_HINT_RANGE, "-1,3600,1,suffix:ticks @60Hz") var transition_tick: int = -1
## Visual-only blend duration; zero means a hard pose change.
@export_range(0, 60, 1, "suffix:ticks @60Hz") var blend_ticks: int = 6
# Filled by the owning ComboGraph; editor hint only, never saved.
var target_suggestions: PackedStringArray = PackedStringArray():
	set(value):
		if value != target_suggestions:
			target_suggestions = value
			notify_property_list_changed()

func _validate_property(property: Dictionary) -> void:
	if property.name == "input":
		property.hint = PROPERTY_HINT_ENUM_SUGGESTION
		property.hint_string = ",".join(INPUTS)
	elif property.name == "target" and not target_suggestions.is_empty():
		property.hint = PROPERTY_HINT_ENUM_SUGGESTION
		property.hint_string = ",".join(target_suggestions)

[sub_resource type="GDScript" id="GDScript_qc4db"]
resource_name = "AutoCollision"
script/source = "extends CollisionShape3D

@onready var mesh_instance := $\"../MeshInstance3D\"

func _ready() -> void:
	var mesh_aabb: AABB = mesh_instance.mesh.get_aabb()
	var mesh_size: Vector3 = mesh_aabb.size
	
	if shape is BoxShape3D:
		shape.size = mesh_size
"


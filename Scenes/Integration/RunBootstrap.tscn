[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Integration/run_bootstrap.gd" id="bootstrap"]
[ext_resource type="Script" path="res://Scripts/Combat/hit_manager_node.gd" id="hit"]
[ext_resource type="PackedScene" path="res://Scenes/Combat/CombatTimeDomains.tscn" id="time_domains"]
[ext_resource type="PackedScene" path="res://Scenes/Rendering/CombatLightRig.tscn" id="light_rig"]
[ext_resource type="PackedScene" path="res://Scenes/GameFeel/FeedbackDirector.tscn" id="feedback"]
[ext_resource type="PackedScene" path="res://Scenes/Components/Player.tscn" id="player"]
[ext_resource type="PackedScene" path="res://Scenes/Components/CameraRig.tscn" id="camera"]
[ext_resource type="Script" path="res://Scripts/Style/style_system.gd" id="style"]
[ext_resource type="Script" path="res://Scripts/Style/style_action_definition.gd" id="action_type"]
[ext_resource type="Resource" path="res://Resources/Style/style_tuning.tres" id="tuning"]
[ext_resource type="Script" path="res://Scripts/Integration/run_controller.gd" id="run"]
[ext_resource type="Script" path="res://Scripts/Integration/sliced_arena_generation.gd" id="generation"]
[ext_resource type="Script" path="res://Scripts/Enemies/encounter_director.gd" id="director"]
[ext_resource type="Script" path="res://Scripts/Integration/placeholder_downed_cinematic.gd" id="cinematic"]
[ext_resource type="Resource" path="res://Resources/Style/action_hit.tres" id="action_hit"]
[ext_resource type="Resource" path="res://Resources/Style/action_kill.tres" id="action_kill"]
[ext_resource type="Resource" path="res://Resources/Style/action_combo_advance.tres" id="action_combo_advance"]
[ext_resource type="Resource" path="res://Resources/Style/action_parry.tres" id="action_parry"]
[ext_resource type="Resource" path="res://Resources/Style/action_execution.tres" id="action_execution"]
[ext_resource type="Resource" path="res://Resources/Style/action_weapon_switch.tres" id="action_weapon_switch"]

[node name="RunBootstrap" type="Node3D" node_paths=PackedStringArray("hit_manager", "player", "style_system", "run", "feedback", "camera_rig")]
script = ExtResource("bootstrap")
hit_manager = NodePath("HitManager")
player = NodePath("Player")
style_system = NodePath("StyleSystem")
run = NodePath("RunController")
feedback = NodePath("FeedbackDirector")
camera_rig = NodePath("CameraRig")

[node name="HitManager" type="Node" parent="."]
script = ExtResource("hit")

[node name="CombatTimeDomains" parent="." instance=ExtResource("time_domains")]

[node name="CombatLightRig" parent="." instance=ExtResource("light_rig")]

[node name="FeedbackDirector" parent="." instance=ExtResource("feedback")]

[node name="Player" parent="." node_paths=PackedStringArray("camera_rig") instance=ExtResource("player")]
camera_rig = NodePath("../CameraRig")

[node name="OrbitPoint" type="Marker3D" parent="Player"]
position = Vector3(0, 1.2, 0)

[node name="CameraRig" parent="." node_paths=PackedStringArray("orbit_point") instance=ExtResource("camera")]
orbit_point = NodePath("../Player/OrbitPoint")

[node name="StyleSystem" type="Node" parent="."]
script = ExtResource("style")
actions = Array[ExtResource("action_type")]([ExtResource("action_hit"), ExtResource("action_kill"), ExtResource("action_combo_advance"), ExtResource("action_parry"), ExtResource("action_execution"), ExtResource("action_weapon_switch")])
tuning = ExtResource("tuning")

[node name="RunController" type="Node" parent="."]
script = ExtResource("run")

[node name="ArenaGeneration" type="Node" parent="RunController"]
script = ExtResource("generation")

[node name="EncounterDirector" type="Node" parent="RunController"]
script = ExtResource("director")

[node name="DownedCinematic" type="Node" parent="RunController"]
script = ExtResource("cinematic")

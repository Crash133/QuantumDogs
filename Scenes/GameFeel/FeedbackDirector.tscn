[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/GameFeel/feedback_director.gd" id="director"]
[ext_resource type="Script" path="res://Scripts/GameFeel/feedback_time_handler.gd" id="time"]
[ext_resource type="Script" path="res://Scripts/GameFeel/feedback_camera_handler.gd" id="camera"]
[ext_resource type="Script" path="res://Scripts/GameFeel/feedback_vfx_handler.gd" id="vfx"]
[ext_resource type="Script" path="res://Scripts/Presentation/attack_presentation_observer.gd" id="observer"]
[ext_resource type="Resource" path="res://Resources/GameFeel/catalog.tres" id="catalog"]
[ext_resource type="Resource" path="res://Resources/Presentation/Weapons/combat_attacks.tres" id="attacks"]

[node name="FeedbackDirector" type="Node" node_paths=PackedStringArray("time_handler", "camera_handler", "vfx_handler", "attack_observer")]
script = ExtResource("director")
catalog = ExtResource("catalog")
attack_catalog = ExtResource("attacks")
time_handler = NodePath("TimeHandler")
camera_handler = NodePath("CameraHandler")
vfx_handler = NodePath("VfxHandler")
attack_observer = NodePath("AttackObserver")

[node name="TimeHandler" type="Node" parent="."]
script = ExtResource("time")

[node name="CameraHandler" type="Node" parent="."]
script = ExtResource("camera")

[node name="VfxHandler" type="Node" parent="."]
script = ExtResource("vfx")

[node name="AttackObserver" type="Node" parent="."]
script = ExtResource("observer")

[gd_scene format=3]

[node name="DefeatSummary" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.015, 0.025, 0.04, 0.90)

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -180.0
offset_right = 260.0
offset_bottom = 180.0
theme_override_constants/separation = 14
alignment = 1

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 40
text = "RUN ENDED"
horizontal_alignment = 1

[node name="DepthLabel" type="Label" parent="Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "DEPTH REACHED: 0"
horizontal_alignment = 1

[node name="StylePointsLabel" type="Label" parent="Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "STYLE POINTS EARNED: 0"
horizontal_alignment = 1

[node name="ContinueReason" type="Label" parent="Column"]
layout_mode = 2
text = "Continue is unavailable after defeat."
horizontal_alignment = 1

[node name="ReturnToMenuButton" type="Button" parent="Column"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "RETURN TO MENU"
